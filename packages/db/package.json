{
  "name": "@verder/db",
  "version": "0.0.1",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "//exports": "The barrel reaches pg. Client components need only the document- and entry-source vocabularies, so those leaf modules are published as their own subpaths.",
