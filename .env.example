# --- Database ---------------------------------------------------------------
# Admin/dev connection (migrations, seed). The web app uses the restricted
# verder_app role in production — see docs/deploy.md.
DATABASE_URL=postgres://verder:verder@localhost:5432/verder
# Worker connects with its own restricted role (pg-boss owns its own schema).
WORKER_DATABASE_URL=postgres://verder_worker:verder_worker@localhost:5432/verder

# --- Storage ----------------------------------------------------------------
# Content-addressed vault directory (inside the container this is /vault).
VAULT_DIR=./vault-files
# NAS folder the worker scans for new documents (inside the container: /scans).
NAS_SCAN_DIR=/mnt/nas/scans

# --- AI (local Ollama only) -------------------------------------------------
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
# Embedding model for the search index (768 dims, asymmetric task prefixes).
# Pull once on the machine running Ollama: ollama pull nomic-embed-text
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Gmail watcher ----------------------------------------------------------
GMAIL_CREDENTIALS_PATH=./secrets/gmail-oauth.json
GMAIL_TOKEN_PATH=./secrets/gmail-token.json
# Comma-separated address filters, shared by the Gmail and the JMAP poller and
# under JMAP the ONLY gate there is — there is no `newer_than:7d` behind it.
# A message is ingested when EITHER its From or one of its To addresses matches
# an entry EXACTLY: a whole address (jan@example.com), or a bare @domain
# (@verdergroep.nl) which admits everybody at that exact domain and no
# subdomain of it. Every parties.email is added to the list automatically, but
# a bare @domain is honoured only HERE, where an operator wrote it on purpose;
# in that column it is unvalidated free text and is refused. Anything that is
# neither shape is thrown out and reported in the run's worker_runs detail.
RELEVANT_SENDERS=@verdergroep.nl

# --- Auth / web app ---------------------------------------------------------
AUTH_SECRET=change-me
APP_URL=http://localhost:3000
# Seed script (pnpm --filter @verder/auth seed) — creates the single user.
SEED_EMAIL=martin@vanderpoel.pro
SEED_PASSWORD=
# Set to 1 only while seeding; leave unset in normal operation so the
# better-auth sign-up endpoint stays disabled.
#ALLOW_SIGNUP=1

# --- Web push notifications -------------------------------------------------
# Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=generate-with-npx-web-push-generate-vapid-keys
VAPID_PRIVATE_KEY=generate-with-npx-web-push-generate-vapid-keys

# --- Production-only (docker-compose.prod.yml / ops/nightly.sh) -------------
# Password for the postgres superuser inside the postgres container.
#POSTGRES_PASSWORD=
# Host path bind-mounted into the containers as /vault.
#VAULT_HOST_DIR=/srv/verder/vault
# Host path (NAS mount) bind-mounted read-only into the worker as /scans.
#NAS_SCAN_HOST_DIR=/mnt/nas/scans
# Where ops/nightly.sh writes DB dumps and the vault mirror.
#BACKUP_DIR=/mnt/nas/verder-backups
TRUSTED_ORIGINS=

# --- Mail: Stalwart over JMAP -----------------------------------------------
# Where the worker reaches the JMAP server. Inside compose that is the service
# name; the port is published to 127.0.0.1 on the homelab host only, and JMAP
# reaches the world through the cloudflared tunnel or not at all.
JMAP_BASE_URL=http://stalwart:8080
# The mailbox login and an APP PASSWORD for it, sent as HTTP Basic.
#
# SETTLED, and JMAP_TOKEN is retired: Stalwart's OAuth access tokens live one
# hour by default (access_token_expiry = 3_600_000 ms, read from
# crates/registry/src/schema/structs_impl.rs:30626 at ref v0.16.19), and raising
# that server-wide to 90 d only moves a silent ingestion death to day 91. An app
# password does not expire unless you give it an expiresAt, and it is revocable
# on its own without touching the account password.
#
# JMAP_USER is the account's e-mail address; the value looks like `app_…`.
# Minted per docs/deploy.md §8.6. Never commit the value.
JMAP_USER=
JMAP_APP_PASSWORD=
# The mailbox owner's own addresses, comma-separated. They sit on EVERY message
# in his own mailbox, so naming one in RELEVANT_SENDERS (or as a party) filters
# nothing at all — it is a whole-mailbox ingest wearing a filter as a hat, one
# unremovable `document.ingested` per attachment of an 11.49 GB archive. Such an
# entry, and any @domain the owner falls under, is refused and reported in
# worker_runs rather than silently obeyed.
#
# AN EMPTY VALUE IS A MISTAKE, NOT A SETTING. `MAIL_OWN_ADDRESSES=` with nothing
# after it falls back to the built-in default (martin@vanderpoel.pro) rather
# than to "this mailbox has no owner", which has no legitimate use. JMAP_USER is
# folded in automatically whenever it is an address, since it IS the polled
# account. Set this only if the dossier ever moves to another person's mailbox.
#MAIL_OWN_ADDRESSES=martin@vanderpoel.pro

# Production-only (docker-compose.prod.yml), all three with defaults that ARE
# the production paths — an unset variable is the documented layout, not a
# broken file, and nothing here may use `${VAR:?}` (see the comment on the
# stalwart service and docs/deploy.md §8.4).
#
# Everything lives on /mnt/data — local NVMe — and nothing on the NAS mount: an
# NFS-backed mail database is how a mail store corrupts. Data and blobs stay
# separately settable because phase 2 may want to split them.
#
# All three directories must be `chown 2000:2000` on the host: the image runs as
# an unprivileged uid 2000.
#
# STALWART_ETC_DIR is new in 0.16 and is load-bearing — Stalwart WRITES
# config.json there itself when the setup wizard finishes, and losing it sends
# the server back into bootstrap mode beside a perfectly good store.
#STALWART_ETC_DIR=/mnt/data/verder/stalwart/etc
#STALWART_DATA_DIR=/mnt/data/verder/stalwart/data
#STALWART_BLOB_DIR=/mnt/data/verder/stalwart/blobs
# The Stalwart administrator login, as `admin:<plaintext password>`. Honoured on
# every start, not only during setup, so it stays the way in if the account
# password is ever lost. Leaving it unset is SAFE: with no config.json yet the
# server boots into bootstrap mode on an ephemeral store and prints a one-time
# random password to `docker compose logs stalwart`.
#STALWART_RECOVERY_ADMIN=
